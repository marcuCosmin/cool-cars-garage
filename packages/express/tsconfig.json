{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext"],
    "module": "es2022",
    "rootDir": "..",
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/backend/*": ["../shared/backend/*"],
      "@/globals/*": ["../shared/globals/*"],
      "@/routes/*": ["./src/routes/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/middlewares/*": ["./src/middlewares/*"],
      "@/models": ["./src/models"],
      "@/firebase/*": ["./src/firebase/*"],
    }
  },
}
